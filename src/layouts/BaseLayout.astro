---
import type { PageProps } from "../lib/interfaces/component";
import { DEFAULT_LANG } from "../lib/i18n";
import { getContent } from "../content";
import "../styles/global.css";
import "aos/dist/aos.css";
import Navbar from "../lib/components/layouts/Navbar.astro";
import Footer from "../lib/components/layouts/Footer.astro";
import logoImg from "../assets/logo.png";
import appleTouchIcon from "../assets/logo.png";

interface Props extends PageProps {}

const {
  lang = DEFAULT_LANG,
  title,
  robots,
  keywords = [],
  opengraph,
  twitter,
  description,
  schemas = [],
} = Astro.props;

const baseUrl = import.meta.env.PUBLIC_DOMAIN || "http://localhost:4321";
const ogImage = opengraph?.image || `${baseUrl}${logoImg.src}`;
const { nav } = getContent(lang);
---

<script is:inline>
  const isBrowser = typeof localStorage !== "undefined";
  const getThemePreference = () => {
    if (isBrowser && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (isBrowser) {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<html lang={lang} translate="no" class="notranslate scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <meta name="generator" content={Astro.generator} />
    <script>
      // Polyfills — processed by Vite/Astro bundler, client-side only.
      // core-js is tree-shaken: only APIs actually missing in the target browser are loaded.
      import "../polyfills";
      import AOS from "aos";

      // Initialize AOS when the DOM is loaded
      const startAos = () => {
        AOS.init({
          duration: 500,
          easing: "ease-out-cubic",
          once: true,
          offset: 80,
          // Reveal animations are decorative — skip them entirely when the OS
          // asks for reduced motion (global.css also neutralises them in CSS).
          disable: () =>
            window.matchMedia("(prefers-reduced-motion: reduce)").matches,
        });
        // Hands opacity control over to aos.css. Until this runs, global.css
        // forces [data-aos] visible so a failed/slow AOS load can never leave
        // the page blank. Set synchronously after init() so the browser never
        // paints the in-between state.
        document.documentElement.setAttribute("data-aos-ready", "");
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startAos);
      } else {
        // Module scripts can resolve after DOMContentLoaded has already fired,
        // in which case the listener above would never run.
        startAos();
      }
    </script>

    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="Ruang Cipta Digital" />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta
      name="theme-color"
      content="#FCFCFD"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#08080B"
      media="(prefers-color-scheme: dark)"
    />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {opengraph?.title && <meta property="og:title" content={opengraph.title} />}
    {
      opengraph?.description && (
        <meta property="og:description" content={opengraph.description} />
      )
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={`${baseUrl}${Astro.url.pathname}`} />
    {opengraph?.type && <meta property="og:type" content={opengraph.type} />}
    {
      opengraph?.tags && (
        <meta property="og:tags" content={opengraph.tags.join(", ")} />
      )
    }
    <meta property="og:locale" content={lang} />
    <meta property="og:site_name" content="Ruang Cipta Digital" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta
      name="twitter:card"
      content={twitter?.card || "summary_large_image"}
    />
    <meta name="twitter:title" content={twitter?.title || title} />
    {
      description && (
        <meta
          name="twitter:description"
          content={twitter?.description || description}
        />
      )
    }
    <meta name="twitter:image" content={twitter?.image || ogImage} />
    <meta name="twitter:site" content="Ruang Cipta Digital" />

    <link rel="canonical" href={`${baseUrl}${Astro.url.pathname}`} />
    <link rel="alternate" hreflang="id" href={`${baseUrl}/id`} />
    <link rel="alternate" hreflang="en" href={`${baseUrl}/en`} />

    {
      robots && (
        <meta
          name="robots"
          content={`${robots.index ? "index" : "noindex"}, ${robots.follow ? "follow" : "nofollow"}`}
        />
      )
    }

    {
      keywords.length > 0 && (
        <meta name="keywords" content={keywords.join(", ")} />
      )
    }

    {
      schemas.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema, null, 4)}
        />
      ))
    }
  </head>
  <body
    class="text-foreground bg-background relative flex min-h-svh scroll-smooth flex-col overflow-x-hidden pt-20 antialiased"
  >
    <a
      href="#main-content"
      class="bg-brand text-brand-on focus-visible:outline-ring sr-only rounded-full px-4 py-2 text-sm font-medium focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-50 focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      {nav.skipToContent}
    </a>

    <Navbar lang={lang} />

    <main id="main-content" class="grow">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
