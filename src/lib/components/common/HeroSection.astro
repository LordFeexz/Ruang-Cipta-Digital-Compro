---
import { Button } from "../ui/button";
import AnimatedGradient from "./AnimatedGradient.svelte";
import type { HeroContent } from "../../../content/types";
import { ArrowRight } from "./icons";

interface Props {
  content: HeroContent;
  /** Small uppercase label above the headline. */
  eyebrow?: string;
  /**
   * Destinations for the two CTAs. Both buttons previously had no href at all
   * and did nothing when clicked.
   */
  primaryLink?: string;
  secondaryLink?: string;
}

const {
  content,
  eyebrow,
  primaryLink = "#products",
  secondaryLink = `mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL}`,
} = Astro.props;
---

<section
  class="relative flex min-h-[88vh] flex-col justify-center overflow-hidden px-4 py-24 sm:px-6 sm:py-32"
>
  <AnimatedGradient client:load />

  <div
    class="relative z-10 container mx-auto max-w-4xl text-center"
    data-aos="fade-up"
    data-aos-duration="700"
  >
    {
      eyebrow && (
        <span class="eyebrow mb-8 inline-flex items-center gap-3">
          <span class="bg-brand/60 h-px w-6" aria-hidden="true" />
          {eyebrow}
        </span>
      )
    }

    <h1 class="font-display text-display text-foreground font-normal">
      {content.headline}
    </h1>

    <p class="text-lede text-muted-foreground mx-auto mt-8 max-w-2xl">
      {content.subheadline}
    </p>

    <div
      class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4"
    >
      <Button
        href={primaryLink}
        variant="brand"
        size="xl"
        class="group w-full sm:w-auto"
      >
        {content.cta1}
        <ArrowRight
          class="size-4 transition-transform group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </Button>
      <Button
        href={secondaryLink}
        variant="brandGhost"
        size="xl"
        class="w-full sm:w-auto"
      >
        {content.cta2}
      </Button>
    </div>
  </div>

  <!-- Optional slot for metrics (used on the product pages) -->
  <div
    class="relative z-10 mt-20 w-full"
    data-aos="fade-up"
    data-aos-delay="150"
  >
    <slot />
  </div>
</section>
