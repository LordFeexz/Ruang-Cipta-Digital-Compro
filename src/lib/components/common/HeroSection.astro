---
import { Button } from "../ui/button";
import CircuitNodes from "./CircuitNodes.astro";
import type { HeroContent } from "../../../content/types";
import { ArrowRight } from "./icons";

interface Props {
  content: HeroContent;
  /** Small uppercase label above the headline. */
  eyebrow?: string;
  /**
   * Destinations for the two CTAs. Both buttons previously had no href at all
   * and did nothing when clicked.
   */
  primaryLink?: string;
  secondaryLink?: string;
}

const {
  content,
  eyebrow,
  primaryLink = "#products",
  secondaryLink = `mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL}`,
} = Astro.props;

// Accent the closing phrase of the headline in flat brand blue. The copy is a
// plain bilingual string, so we split off the last two words — both the EN and
// ID headlines end on the phrase that carries the point.
const words = content.headline.trim().split(/\s+/);
const accentCount = Math.min(2, Math.max(words.length - 1, 1));
const lead = words.slice(0, words.length - accentCount).join(" ");
const accent = words.slice(words.length - accentCount).join(" ");
---

<section
  class="bg-background relative flex min-h-[88vh] flex-col justify-center overflow-hidden px-4 py-24 sm:px-6 sm:py-32"
>
  <!-- Engineering-paper ground + a single circuit trace: this band's entire
       decoration budget. Flat, theme-aware, zero assets. -->
  <div
    class="blueprint-grid blueprint-fade absolute inset-0"
    aria-hidden="true"
  >
  </div>
  <CircuitNodes class="absolute top-16 -right-8 hidden w-64 opacity-50 lg:block" />

  <div
    class="relative z-10 container mx-auto max-w-4xl text-center"
    data-aos="fade-up"
    data-aos-duration="700"
  >
    {
      eyebrow && (
        <span class="eyebrow mb-8 inline-flex items-center gap-2.5">
          <span class="circuit-node" aria-hidden="true" />
          {eyebrow}
        </span>
      )
    }

    <h1 class="font-display text-display text-foreground">
      {lead ? `${lead} ` : ""}<span class="text-brand">{accent}</span>
    </h1>

    <p class="text-lede text-muted-foreground mx-auto mt-8 max-w-2xl">
      {content.subheadline}
    </p>

    <div
      class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4"
    >
      <Button
        href={primaryLink}
        variant="brand"
        size="xl"
        class="group w-full sm:w-auto"
      >
        {content.cta1}
        <ArrowRight
          class="size-4 transition-transform group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </Button>
      <Button
        href={secondaryLink}
        variant="brandGhost"
        size="xl"
        class="w-full sm:w-auto"
      >
        {content.cta2}
      </Button>
    </div>
  </div>

  <!-- Optional slot for metrics (used on the product pages) -->
  <div
    class="relative z-10 mt-20 w-full"
    data-aos="fade-up"
    data-aos-delay="150"
  >
    <slot />
  </div>
</section>
