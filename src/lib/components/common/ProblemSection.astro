---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import type { PitchContent } from "../../../content/types";

interface Props {
  content: PitchContent;
  eyebrow?: string;
}

const { content, eyebrow } = Astro.props;

// description[0] is the framing sentence; the rest are the enumerated pains.
const [intro, ...items] = content.description;
---

<SectionWrapper>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-20"
  >
    <div class="lg:sticky lg:top-32 lg:self-start">
      <SectionHeading
        title={content.title}
        eyebrow={eyebrow}
        lede={intro}
        align="left"
      />
    </div>

    <ol class="border-border divide-border divide-y border-y">
      {
        items.map((item, index) => (
          <li
            class="flex items-center gap-6 py-6"
            data-aos="fade-up"
            data-aos-delay={index * 80}
          >
            <span
              class="font-display text-figure text-brand shrink-0"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <p class="text-foreground text-base leading-relaxed sm:text-lg">
              {item}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</SectionWrapper>
