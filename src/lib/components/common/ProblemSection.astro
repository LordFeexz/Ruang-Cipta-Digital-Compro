---
import SectionWrapper from "./SectionWrapper.astro";
import type { PitchContent } from "../../../content/types";
import { Minus } from "./icons";

interface Props {
  content: PitchContent;
  eyebrow?: string;
}

const { content, eyebrow } = Astro.props;
---

<SectionWrapper>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-20"
  >
    <div class="lg:sticky lg:top-32 lg:self-start">
      {
        eyebrow && (
          <span class="eyebrow mb-4 flex items-center gap-3">
            <span class="bg-brand/60 h-px w-6" aria-hidden="true" />
            {eyebrow}
          </span>
        )
      }
      <h2 class="font-display text-title text-foreground font-normal">
        {content.title}
      </h2>
      <p class="text-lede text-muted-foreground mt-5">
        {content.description[0]}
      </p>
    </div>

    <ul class="border-border divide-border divide-y border-t border-b">
      {
        content.description.slice(1).map((item, index) => (
          <li
            class="flex items-start gap-4 py-6"
            data-aos="fade-up"
            data-aos-delay={index * 80}
          >
            <Minus
              class="text-brand mt-2 size-4 shrink-0"
              aria-hidden="true"
            />
            <p class="text-foreground text-base leading-relaxed sm:text-lg">
              {item}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</SectionWrapper>
