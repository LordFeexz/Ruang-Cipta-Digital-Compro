---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import GlowCard from "./GlowCard.astro";
import type { RoadmapPhase } from "../../../content/types";

interface Props {
  roadmap: RoadmapPhase[];
  title: string;
  eyebrow?: string;
}

const { roadmap, title, eyebrow } = Astro.props;
---

<SectionWrapper>
  <SectionHeading title={title} eyebrow={eyebrow} class="mb-14" />

  <ol class="mx-auto grid max-w-6xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      roadmap.map((item, index) => (
        <li class="relative">
          {/* Connector between phases on desktop */}
          {index < roadmap.length - 1 && (
            <div
              class="bg-border absolute top-1/2 right-[calc(-50%+2rem)] left-[calc(50%+2rem)] z-0 hidden h-px -translate-y-1/2 lg:block"
              aria-hidden="true"
            />
          )}

          <GlowCard class="relative z-10" delay={index * 80}>
            <span class="eyebrow text-brand-quiet mb-4 block">
              {item.phase}
            </span>
            <h3 class="text-heading text-foreground font-medium">
              {item.title}
            </h3>
          </GlowCard>
        </li>
      ))
    }
  </ol>
</SectionWrapper>
