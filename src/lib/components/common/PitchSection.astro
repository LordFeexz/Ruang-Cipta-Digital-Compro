---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import type { PitchContent } from "../../../content/types";

interface Props {
  content: PitchContent;
  align?: "left" | "center";
  eyebrow?: string;
  class?: string;
}

const { content, align = "center", eyebrow, class: className } = Astro.props;

// Big-statement typography: the first paragraph is the statement, the rest
// are supporting copy.
const [statement, ...rest] = content.description;
---

<SectionWrapper class={className}>
  {
    align === "left" ? (
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-20">
        <SectionHeading title={content.title} eyebrow={eyebrow} align="left" />

        <div class="space-y-5 lg:pt-2">
          {statement && (
            <p class="font-display text-heading text-foreground">{statement}</p>
          )}
          {rest.map((paragraph) => (
            <p class="text-lede text-muted-foreground">{paragraph}</p>
          ))}
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-3xl">
        <SectionHeading title={content.title} eyebrow={eyebrow} align="center" />

        <div class="mt-8 space-y-5 text-center">
          {statement && (
            <p class="font-display text-heading text-foreground">{statement}</p>
          )}
          {rest.map((paragraph) => (
            <p class="text-lede text-muted-foreground">{paragraph}</p>
          ))}
        </div>
      </div>
    )
  }
</SectionWrapper>
