---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import type { PitchContent } from "../../../content/types";
import { cn } from "../../../lib/utils";

interface Props {
  content: PitchContent;
  align?: "left" | "center";
  eyebrow?: string;
  class?: string;
}

const { content, align = "center", eyebrow, class: className } = Astro.props;
---

<SectionWrapper class={className}>
  <SectionHeading title={content.title} eyebrow={eyebrow} align={align} />

  <div
    class={cn(
      "mt-8 max-w-3xl space-y-5",
      align === "center" && "mx-auto text-center",
    )}
  >
    {
      content.description.map((paragraph) => (
        <p class="text-lede text-muted-foreground">{paragraph}</p>
      ))
    }
  </div>
</SectionWrapper>
