---
import { cn } from "../../../lib/utils";

interface Props {
  class?: string;
  /**
   * AOS stagger in ms, forwarded as `data-aos-delay`. A Tailwind
   * `delay-[${i * 100}ms]` class built from an interpolated value is never
   * generated by the v4 scanner, so the previous approach silently did nothing.
   */
  delay?: number;
}

const { class: className = "", delay } = Astro.props;
---

<!-- Historical name; since the flat redesign this is the plain bento card
     primitive — 1px border, no shadow, hover snaps the border to brand. -->
<div
  class={cn(
    "group flat-card flat-card-hover relative h-full overflow-hidden p-6 sm:p-8",
    className,
  )}
  data-aos="fade-up"
  data-aos-duration="500"
  data-aos-delay={delay}
>
  <slot />
</div>
