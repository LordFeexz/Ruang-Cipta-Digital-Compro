---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import GlowCard from "./GlowCard.astro";
import type { MissionCard } from "../../../content/types";
import { Leaf, Lightbulb, Unlock, Zap } from "./icons";

interface Props {
  missions: MissionCard[];
  eyebrow?: string;
  title?: string;
}

const { missions, eyebrow, title } = Astro.props;

// Map icon names to Lucide components
const getIcon = (name: string) => {
  switch (name) {
    case "Unlock":
      return Unlock;
    case "Zap":
      return Zap;
    case "Lightbulb":
      return Lightbulb;
    case "Leaf":
      return Leaf;
    default:
      return Lightbulb;
  }
};
---

<SectionWrapper>
  {title && <SectionHeading title={title} eyebrow={eyebrow} class="mb-14" />}

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
    {
      missions.map((mission, index) => {
        const Icon = getIcon(mission.icon);
        return (
          <GlowCard delay={index * 80}>
            <div class="bg-brand-soft text-brand mb-6 flex size-11 items-center justify-center rounded-xl">
              <Icon class="size-5" aria-hidden="true" />
            </div>
            <h3 class="text-heading text-foreground mb-3 font-medium">
              {mission.title}
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              {mission.description}
            </p>
          </GlowCard>
        );
      })
    }
  </div>
</SectionWrapper>
