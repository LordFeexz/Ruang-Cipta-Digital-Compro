---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import GlowCard from "./GlowCard.astro";
import type { BusinessModelCard } from "../../../content/types";

interface Props {
  models: BusinessModelCard[];
  title: string;
  eyebrow?: string;
}

const { models, title, eyebrow } = Astro.props;
---

<SectionWrapper>
  <SectionHeading title={title} eyebrow={eyebrow} class="mb-14" />

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      models.map((model, index) => (
        <GlowCard class="flex flex-col justify-between" delay={index * 80}>
          {/* An index reads as a set; the previous version repeated one
              Briefcase icon four times, which said nothing. */}
          <span class="eyebrow text-brand-quiet" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="text-heading text-foreground mt-10 font-medium">
            {model.title}
          </h3>
        </GlowCard>
      ))
    }
  </div>
</SectionWrapper>
