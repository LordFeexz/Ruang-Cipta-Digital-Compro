---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import type { ComparisonRow } from "../../../content/types";
import { Check, X } from "./icons";

interface Props {
  data: ComparisonRow[];
  title: string;
  lede?: string;
  eyebrow?: string;
  headings: { feature: string; product: string; traditional: string };
}

const { data, title, lede, eyebrow, headings } = Astro.props;

// The "not supported" marker is authored as a localized string, so both
// spellings have to be recognised.
const isNegative = (value: string) =>
  ["no", "tidak"].includes(value.trim().toLowerCase());
---

<SectionWrapper>
  <SectionHeading
    title={title}
    lede={lede}
    eyebrow={eyebrow}
    class="mb-14"
  />

  <div
    class="border-border bg-card mx-auto max-w-4xl overflow-hidden rounded-2xl border"
  >
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">{title}</caption>
        <thead>
          <tr class="border-border bg-muted border-b">
            <th
              scope="col"
              class="text-muted-foreground w-1/3 p-5 text-sm font-medium"
            >
              {headings.feature}
            </th>
            <th
              scope="col"
              class="text-foreground w-1/3 p-5 text-sm font-medium"
            >
              {headings.product}
            </th>
            <th
              scope="col"
              class="text-muted-foreground w-1/3 p-5 text-sm font-medium"
            >
              {headings.traditional}
            </th>
          </tr>
        </thead>
        <tbody>
          {
            data.map((row) => (
              <tr class="border-border hover:bg-accent border-b transition-colors last:border-b-0">
                <th
                  scope="row"
                  class="text-foreground p-5 text-left text-base font-normal"
                >
                  {row.feature}
                </th>
                <td class="p-5">
                  <div class="flex items-center gap-2.5">
                    <span
                      class="bg-brand-soft text-brand grid size-5 shrink-0 place-items-center rounded-full"
                      aria-hidden="true"
                    >
                      <Check class="size-3" />
                    </span>
                    <span class="text-foreground text-base">{row.product}</span>
                  </div>
                </td>
                <td class="p-5">
                  <div class="text-muted-foreground flex items-center gap-2.5">
                    {/* Icon shape AND colour differ, so the distinction is not
                        carried by colour alone. */}
                    {isNegative(row.traditional) ? (
                      <span
                        class="bg-destructive/10 text-destructive grid size-5 shrink-0 place-items-center rounded-full"
                        aria-hidden="true"
                      >
                        <X class="size-3" />
                      </span>
                    ) : (
                      <span
                        class="bg-muted text-muted-foreground grid size-5 shrink-0 place-items-center rounded-full"
                        aria-hidden="true"
                      >
                        <Check class="size-3" />
                      </span>
                    )}
                    <span class="text-base">{row.traditional}</span>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</SectionWrapper>
