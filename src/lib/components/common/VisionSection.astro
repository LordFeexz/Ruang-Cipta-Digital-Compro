---
import SectionWrapper from "./SectionWrapper.astro";

interface Props {
  vision: string;
  eyebrow?: string;
}

const { vision, eyebrow } = Astro.props;
---

<SectionWrapper class="bg-secondary border-border border-y">
  <figure class="mx-auto max-w-3xl text-center">
    {
      eyebrow && (
        <figcaption class="eyebrow mb-8 inline-flex items-center gap-2.5">
          <span class="circuit-node" aria-hidden="true" />
          {eyebrow}
        </figcaption>
      )
    }
    <blockquote class="font-display text-title text-foreground">
      <span aria-hidden="true" class="text-brand">&ldquo;</span>{vision}<span
        aria-hidden="true"
        class="text-brand">&rdquo;</span
      >
    </blockquote>
  </figure>
</SectionWrapper>
