---
import SectionWrapper from "./SectionWrapper.astro";
import CircuitNodes from "./CircuitNodes.astro";

import type { CTASectionContent } from "../../../content/types";
import { ArrowRight } from "./icons";

interface Props {
  content: CTASectionContent;
  primaryLink?: string;
  secondaryLink?: string;
  eyebrow?: string;
}

const {
  content,
  eyebrow,
  primaryLink = `mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL}`,
  secondaryLink = `mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL}`,
} = Astro.props;
---

<SectionWrapper>
  <div
    class="bg-foreground relative mx-auto max-w-5xl overflow-hidden rounded-3xl px-6 py-16 text-center sm:px-12 sm:py-24"
    data-aos="fade-up"
  >
    <!-- Faint engineering-paper grid, fading toward the edges -->
    <div
      class="blueprint-grid blueprint-fade pointer-events-none absolute inset-0 opacity-20"
      aria-hidden="true"
    >
    </div>

    <CircuitNodes
      class="pointer-events-none absolute -right-8 -bottom-10 w-64 opacity-40"
    />

    <div class="relative z-10">
      {
        eyebrow && (
          <span class="text-eyebrow text-background/70 font-display mb-6 inline-flex items-center gap-2.5 uppercase">
            <span
              class="bg-circuit inline-block size-2 rounded-[2px]"
              aria-hidden="true"
            />
            {eyebrow}
          </span>
        )
      }

      <h2
        class="font-display text-display text-background mx-auto max-w-3xl"
      >
        {content.title}
      </h2>

      <div
        class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4"
      >
        <a
          href={primaryLink}
          class="group bg-background text-foreground hover:bg-secondary inline-flex h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-lg px-6 font-medium transition-colors duration-200 sm:w-auto"
        >
          {content.button1}
          <ArrowRight
            class="size-4 transition-transform group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </a>

        {
          content.button2 && (
            <a
              href={secondaryLink}
              class="border-background/25 text-background hover:border-background/50 hover:bg-background/10 inline-flex h-12 w-full cursor-pointer items-center justify-center rounded-lg border bg-transparent px-6 font-medium transition-colors duration-200 sm:w-auto"
            >
              {content.button2}
            </a>
          )
        }
      </div>
    </div>
  </div>
</SectionWrapper>
