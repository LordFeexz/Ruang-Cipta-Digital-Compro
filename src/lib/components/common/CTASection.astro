---
import SectionWrapper from "./SectionWrapper.astro";
import { Button } from "../ui/button";

import type { CTASectionContent } from "../../../content/types";
import { ArrowRight } from "./icons";

interface Props {
  content: CTASectionContent;
  primaryLink?: string;
  secondaryLink?: string;
  eyebrow?: string;
}

const {
  content,
  eyebrow,
  primaryLink = `mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL}`,
  secondaryLink = `mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL}`,
} = Astro.props;
---

<SectionWrapper>
  <div
    class="border-border bg-card relative mx-auto max-w-4xl overflow-hidden rounded-3xl border px-6 py-16 text-center sm:px-12 sm:py-20"
    data-aos="fade-up"
  >
    <!-- Single soft brand wash, replacing the three stacked glow layers -->
    <div
      class="bg-brand/10 pointer-events-none absolute -top-32 left-1/2 size-80 -translate-x-1/2 rounded-full blur-[100px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10">
      {
        eyebrow && (
          <span class="eyebrow mb-6 inline-flex items-center gap-3">
            <span class="bg-brand/60 h-px w-6" aria-hidden="true" />
            {eyebrow}
          </span>
        )
      }

      <h2
        class="font-display text-title text-foreground mx-auto max-w-2xl font-normal"
      >
        {content.title}
      </h2>

      <div
        class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4"
      >
        <Button
          href={primaryLink}
          variant="brand"
          size="xl"
          class="group w-full sm:w-auto"
        >
          {content.button1}
          <ArrowRight
            class="size-4 transition-transform group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </Button>

        {
          content.button2 && (
            <Button
              href={secondaryLink}
              variant="brandGhost"
              size="xl"
              class="w-full sm:w-auto"
            >
              {content.button2}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</SectionWrapper>
