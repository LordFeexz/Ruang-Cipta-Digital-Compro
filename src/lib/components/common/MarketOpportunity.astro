---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import type { PitchContent } from "../../../content/types";
import { BarChart3, PieChart, TrendingUp } from "./icons";

interface Props {
  content: PitchContent;
  eyebrow?: string;
}

const { content, eyebrow } = Astro.props;

// One consistent icon treatment — the previous version hardcoded blue-500,
// purple-500 and brand-secondary, none of which were theme tokens.
const cards = [
  { icon: TrendingUp, label: content.description[0] },
  { icon: BarChart3, label: content.description[1] },
  { icon: PieChart, label: content.description[2] },
].filter((card) => Boolean(card.label));
---

<SectionWrapper>
  <SectionHeading title={content.title} eyebrow={eyebrow} class="mb-14" />

  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-3 sm:gap-4 md:grid-cols-3">
    {
      cards.map((card, index) => {
        const Icon = card.icon;
        return (
          <div
            class="flat-card flat-card-hover flex flex-col p-6 sm:p-8"
            data-aos="fade-up"
            data-aos-delay={index * 80}
          >
            <div class="mb-8 flex items-start justify-between">
              <div class="bg-brand-soft text-brand flex size-12 items-center justify-center rounded-xl">
                <Icon class="size-6" aria-hidden="true" />
              </div>
              <span
                class="font-display text-eyebrow text-muted-foreground"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <h3 class="text-heading text-foreground">
              {card.label}
            </h3>
          </div>
        );
      })
    }
  </div>
</SectionWrapper>
