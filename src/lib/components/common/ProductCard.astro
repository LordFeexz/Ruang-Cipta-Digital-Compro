---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import GlowCard from "./GlowCard.astro";
import { Button } from "../ui/button";
import type { ProductCardContent } from "../../../content/types";
import { ArrowUpRight } from "./icons";

interface Props {
  products: ProductCardContent[];
  title: string;
  eyebrow?: string;
  badgeLabel: string;
}

const { products, title, eyebrow, badgeLabel } = Astro.props;
---

<SectionWrapper id="products">
  <SectionHeading title={title} eyebrow={eyebrow} class="mb-14" />

  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 md:grid-cols-2">
    {
      products.map((product, index) => (
        <GlowCard class="flex h-full flex-col" delay={index * 80}>
          <div class="grow">
            <span class="eyebrow text-brand-quiet mb-6 block">
              {badgeLabel}
            </span>
            <h3 class="font-display text-foreground mb-4 text-2xl font-normal sm:text-3xl">
              {product.name}
            </h3>
            <p class="text-foreground mb-4 text-base sm:text-lg">
              {product.description}
            </p>
            <p class="text-muted-foreground text-sm leading-relaxed">
              {product.valueProp}
            </p>
          </div>

          <div class="border-border mt-8 border-t pt-6">
            <Button
              href={product.link}
              target="_blank"
              rel="noopener noreferrer"
              variant="ghost"
              class="hover:bg-accent -mx-2 h-11 w-full justify-between rounded-lg px-2"
            >
              {product.cta}
              <ArrowUpRight
                class="size-4 transition-transform group-hover/button:translate-x-0.5 group-hover/button:-translate-y-0.5"
                aria-hidden="true"
              />
            </Button>
          </div>
        </GlowCard>
      ))
    }
  </div>
</SectionWrapper>
