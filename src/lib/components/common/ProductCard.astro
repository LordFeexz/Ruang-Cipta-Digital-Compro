---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import GlowCard from "./GlowCard.astro";
import type { ProductCardContent } from "../../../content/types";
import { ArrowUpRight, BarChart3, PieChart, TrendingUp, Zap } from "./icons";

interface Props {
  products: ProductCardContent[];
  title: string;
  eyebrow?: string;
  badgeLabel: string;
}

const { products, title, eyebrow, badgeLabel } = Astro.props;

// Products carry no icon in the content model, so assign one per slot to keep
// the icon chips varied without inventing new content strings.
const chipIcons = [Zap, BarChart3, TrendingUp, PieChart];
---

<SectionWrapper id="products">
  <SectionHeading title={title} eyebrow={eyebrow} class="mb-14" />

  <!-- Bento: tight gaps, first product is the feature cell (2 cols on lg). -->
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-3 sm:gap-4 lg:grid-cols-3">
    {
      products.map((product, index) => {
        const Icon = chipIcons[index % chipIcons.length];
        return (
          <GlowCard
            class={`flex h-full flex-col ${index === 0 ? "lg:col-span-2" : ""}`}
            delay={index * 80}
          >
            <div class="grow">
              <div class="mb-8 flex items-start justify-between gap-4">
                <div class="bg-brand-soft text-brand flex size-12 items-center justify-center rounded-xl">
                  <Icon class="size-6" aria-hidden="true" />
                </div>
                <span class="eyebrow flex items-center gap-2">
                  <span class="circuit-node" aria-hidden="true"></span>
                  {badgeLabel}
                </span>
              </div>

              <h3 class="font-display text-heading text-foreground mb-3">
                {product.name}
              </h3>
              <p class="text-foreground mb-3 text-base">
                {product.description}
              </p>
              <p class="text-muted-foreground text-sm leading-relaxed">
                {product.valueProp}
              </p>
            </div>

            <div class="border-border mt-8 border-t pt-5">
              <a
                href={product.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group/link text-foreground hover:text-brand-quiet inline-flex min-h-11 w-full cursor-pointer items-center justify-between rounded-lg font-medium transition-colors duration-200"
              >
                {product.cta}
                <ArrowUpRight
                  class="text-brand size-4 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
                  aria-hidden="true"
                />
              </a>
            </div>
          </GlowCard>
        );
      })
    }
  </div>
</SectionWrapper>
