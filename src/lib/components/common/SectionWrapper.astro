---
import { cn } from "../../../lib/utils";

interface Props {
  class?: string;
  id?: string;
}

const { class: className = "", id } = Astro.props;
---

<section
  id={id}
  class={cn("relative overflow-hidden py-24 sm:py-32 lg:py-36", className)}
  data-aos="fade-up"
>
  <div class="relative z-10 container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <slot />
  </div>
</section>
