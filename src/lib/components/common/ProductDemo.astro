---
import SectionWrapper from "./SectionWrapper.astro";
import SectionHeading from "./SectionHeading.astro";
import type { FeatureDemo } from "../../../content/types";
import { Check } from "./icons";

interface Props {
  demo: FeatureDemo;
  eyebrow?: string;
}

const { demo, eyebrow } = Astro.props;
---

<SectionWrapper class="bg-card border-border border-y">
  <SectionHeading title={demo.title} eyebrow={eyebrow} class="mb-14" />

  <div
    class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16"
  >
    <!-- UI mockup. Built entirely from surface tokens so it reads as a real
         product window in both themes. -->
    <div class="order-2 lg:order-1 lg:col-span-7" data-aos="fade-up">
      <div
        class="border-border bg-background relative aspect-16/10 overflow-hidden rounded-xl border shadow-xl"
        aria-hidden="true"
      >
        <!-- Window chrome -->
        <div
          class="bg-muted border-border flex h-9 items-center gap-2 border-b px-4"
        >
          <div class="flex gap-1.5">
            <div class="bg-muted-foreground/30 size-2.5 rounded-full"></div>
            <div class="bg-muted-foreground/30 size-2.5 rounded-full"></div>
            <div class="bg-muted-foreground/30 size-2.5 rounded-full"></div>
          </div>
          <div class="bg-background/80 mx-auto h-5 w-1/2 max-w-sm rounded-md"></div>
        </div>

        <!-- Content -->
        <div class="flex h-full flex-col gap-5 p-5">
          <div class="flex items-center justify-between">
            <div class="bg-muted h-5 w-28 rounded-md"></div>
            <div class="flex items-center gap-3">
              <div class="bg-muted h-5 w-14 rounded-md"></div>
              <div class="bg-muted h-5 w-14 rounded-md"></div>
              <div class="bg-brand-soft size-7 rounded-full"></div>
            </div>
          </div>

          <div class="flex h-full gap-5">
            <!-- Sidebar -->
            <div class="hidden w-40 flex-col gap-2.5 md:flex">
              <div class="bg-brand-soft h-7 w-full rounded-md"></div>
              <div class="bg-muted h-7 w-full rounded-md"></div>
              <div class="bg-muted h-7 w-full rounded-md"></div>
              <div class="bg-muted h-7 w-full rounded-md"></div>
            </div>

            <!-- Main grid -->
            <div class="grid grow grid-cols-2 gap-3.5">
              <div
                class="border-border bg-brand-soft col-span-2 h-28 rounded-xl border"
              >
              </div>
              <div class="border-border bg-muted h-36 rounded-xl border"></div>
              <div class="border-border bg-muted h-36 rounded-xl border"></div>
              <div
                class="border-border bg-muted col-span-2 h-20 rounded-xl border"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature list -->
    <ul class="order-1 space-y-1 lg:order-2 lg:col-span-5">
      {
        demo.features.map((feature, index) => (
          <li
            class="hover:bg-accent flex items-start gap-4 rounded-xl p-4 transition-colors"
            data-aos="fade-up"
            data-aos-delay={index * 80}
          >
            <span
              class="bg-brand-soft text-brand mt-0.5 grid size-6 shrink-0 place-items-center rounded-full"
              aria-hidden="true"
            >
              <Check class="size-3.5" />
            </span>
            <h3 class="text-foreground text-base font-medium sm:text-lg">
              {feature}
            </h3>
          </li>
        ))
      }
    </ul>
  </div>
</SectionWrapper>
