---
import { Card } from "../ui/card";
import { Separator } from "../ui/separator";
import { Mail, BarChart3, ArrowRight, type AstroIcon } from "../common/icons";
import SearchIcon from "@lucide/svelte/icons/search";
import FileTextIcon from "@lucide/svelte/icons/file-text";
import CodeIcon from "@lucide/svelte/icons/code";
const Search = SearchIcon as unknown as AstroIcon;
const FileText = FileTextIcon as unknown as AstroIcon;
const Code = CodeIcon as unknown as AstroIcon;
interface Props { digitool: boolean; }
const { digitool } = Astro.props;
const tools = [{ label: "CV Builder", icon: FileText }, { label: "Optimasi CV", icon: Code }, { label: "Cover Letter", icon: Mail }, { label: "Skor CV", icon: BarChart3 }];
---
<figure class="my-9 sm:my-12" aria-label={digitool ? "Ilustrasi katalog Digitool" : "Ilustrasi fitur Role Mate"}>
  <Card class="gap-0 rounded-t-xl rounded-b-none border border-border bg-card p-0 shadow-none ring-0">
    <div class="flex items-center justify-between gap-4 bg-secondary px-4 py-3 text-[10px] tracking-[0.14em] text-muted-foreground">
      <span aria-hidden="true" class="flex gap-1.5"><span class="size-1.5 rounded-full bg-muted-foreground/40"></span><span class="size-1.5 rounded-full bg-muted-foreground/40"></span><span class="size-1.5 rounded-full bg-muted-foreground/40"></span></span>
      <span>{digitool ? "DIGITOOL" : "ROLE MATE"}</span><span aria-hidden="true">↗</span>
    </div>
    <Separator />
    <div class="bg-radial-[at_90%_10%] from-primary/10 to-transparent px-4 py-7 sm:px-10 sm:py-9">
      <p class="text-[9px] tracking-[0.16em] text-muted-foreground">{digitool ? "YOUR DIGITAL TOOLKIT" : "CAREER WORKSPACE"}</p>
      <h2 class="mt-3 mb-6 text-xl leading-snug font-semibold tracking-tight sm:text-[29px]">{digitool ? "Temukan awal yang lebih mudah." : "Siapkan langkah berikutnya."}</h2>
      {digitool ? (
        <div class="grid grid-cols-3 gap-3 sm:gap-5">
          <div class="min-w-0">
            <div class="flex aspect-[3/4] flex-col gap-2 rounded-md bg-foreground p-3 sm:gap-3 sm:p-5" aria-hidden="true">
              <span class="mb-1 size-5 rounded-full bg-primary/50 sm:size-8"></span>
              <span class="h-1 w-full bg-primary/30"></span><span class="h-1 w-full bg-primary/30"></span><span class="h-1 w-full bg-primary/30"></span><span class="h-1 w-3/5 bg-primary/30"></span>
            </div>
            <p class="mt-3 text-xs font-medium sm:text-sm">Template CV</p><p class="mt-1 text-[10px] leading-relaxed text-muted-foreground sm:text-xs">Editable document</p>
          </div>
          <div class="min-w-0">
            <div class="flex aspect-[3/4] flex-col justify-center gap-3 rounded-md bg-brand-soft p-3 text-brand-quiet sm:p-5" aria-hidden="true"><span class="font-mono text-2xl sm:text-4xl">&gt;_</span><span class="text-[7px] tracking-wide sm:text-[10px]">IDEAS INTO WORDS</span></div>
            <p class="mt-3 text-xs font-medium sm:text-sm">AI Prompts</p><p class="mt-1 text-[10px] leading-relaxed text-muted-foreground sm:text-xs">Creative resources</p>
          </div>
          <div class="min-w-0">
            <div class="flex aspect-[3/4] items-start rounded-md bg-accent p-3 text-sm leading-relaxed font-semibold text-brand-quiet sm:p-5 sm:text-xl" aria-hidden="true">THE<br />DIGITAL<br />TOOLKIT</div>
            <p class="mt-3 text-xs font-medium sm:text-sm">E-Books</p><p class="mt-1 text-[10px] leading-relaxed text-muted-foreground sm:text-xs">Learn & explore</p>
          </div>
        </div>
      ) : (
        <>
          <div class="flex items-center gap-2 rounded-md border border-input px-3 py-4 text-xs text-muted-foreground sm:text-sm" aria-hidden="true"><Search class="size-4 shrink-0" /><span class="min-w-0 flex-1">Posisi, perusahaan, atau keahlian</span><ArrowRight class="size-4 shrink-0 text-brand-quiet" /></div>
          <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
            {tools.map(({ label, icon: Icon }) => <div class="flex flex-col gap-3 rounded-md border border-border bg-secondary p-4"><Icon class="size-5 text-brand-quiet" aria-hidden="true" /><span class="text-xs text-secondary-foreground">{label}</span></div>)}
          </div>
        </>
      )}
    </div>
  </Card>
  <figcaption class="rounded-b-xl border border-t-0 border-border bg-card px-4 py-3 text-[10px] leading-relaxed tracking-[0.08em] text-muted-foreground uppercase">{digitool ? "Ilustrasi katalog" : "Ilustrasi fitur"} · Bukan screenshot aplikasi</figcaption>
</figure>
