---
import { getContent } from "../../../content";
import { DEFAULT_LANG } from "../../../lib/i18n";
import logoImg from "../../../assets/logo.png";
import { Mail } from "../common/icons";
import CircuitNodes from "../common/CircuitNodes.astro";

interface Props {
  lang?: string;
}

const { lang = DEFAULT_LANG } = Astro.props;
const content = getContent(lang);
const { nav, footer } = content;

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;

const productLinks = [
  { href: `/${lang}/career-mate`, label: nav.careerMate },
  { href: `/${lang}/digitool`, label: nav.digiTool },
];
---

<footer class="border-border bg-secondary relative overflow-hidden border-t">
  <CircuitNodes
    class="pointer-events-none absolute -top-6 -right-8 hidden w-64 opacity-25 md:block"
  />

  <div class="relative container mx-auto px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a
          href={`/${lang}`}
          class="inline-flex items-center gap-3"
          aria-label={nav.home}
        >
          <img
            src={logoImg.src}
            alt=""
            width="32"
            height="32"
            class="h-8 w-auto"
          />
          <span class="font-display text-base font-semibold tracking-tight">
            Ruang Cipta Digital
          </span>
        </a>
        <p class="text-muted-foreground mt-5 max-w-sm text-sm leading-relaxed">
          {content.home.hero.subheadline}
        </p>
      </div>

      <!-- Products -->
      <nav aria-labelledby="footer-products">
        <h2 id="footer-products" class="eyebrow mb-5 flex items-center gap-2.5">
          <span class="circuit-node" aria-hidden="true"></span>
          {nav.products}
        </h2>
        <ul class="space-y-3">
          {
            productLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-muted-foreground hover:text-brand-quiet text-sm transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h2 class="eyebrow mb-5 flex items-center gap-2.5">
          <span class="circuit-node" aria-hidden="true"></span>
          {nav.contact}
        </h2>
        <a
          href={`mailto:${contactEmail}`}
          class="text-muted-foreground hover:text-brand-quiet inline-flex items-center gap-2 text-sm transition-colors duration-200"
        >
          <Mail class="size-4 shrink-0" aria-hidden="true" />
          {contactEmail}
        </a>
      </div>
    </div>

    <!-- Thin bottom bar -->
    <div
      class="border-border mt-14 flex flex-col gap-3 border-t pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-muted-foreground text-sm">
        {footer.copyright}
      </p>
      <span
        class="text-muted-foreground flex items-center gap-2.5 text-sm"
        aria-hidden="true"
      >
        <span class="circuit-node"></span>
        Ruang Cipta Digital
      </span>
    </div>
  </div>
</footer>
