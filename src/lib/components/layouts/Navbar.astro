---
import { getContent } from "../../../content";
import LanguageSwitcher from "../common/LanguageSwitcher.svelte";
import ThemeToggle from "../common/ThemeToggle.svelte";
import MobileMenu from "../common/MobileMenu.svelte";
import { DEFAULT_LANG } from "../../../lib/i18n";
import { Button } from "../ui/button";
import logoImg from "../../../assets/logo.png";

interface Props {
  lang?: string;
}

const { lang = DEFAULT_LANG } = Astro.props;
const content = getContent(lang);
const nav = content.nav;

const links = [
  { href: `/${lang}/career-mate`, label: nav.careerMate },
  { href: `/${lang}/digitool`, label: nav.digiTool },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<header
  class="border-border bg-background/80 fixed top-0 right-0 left-0 z-40 border-b backdrop-blur-xl"
>
  <div
    class="container mx-auto flex h-20 items-center justify-between px-4 sm:px-6"
  >
    <a href={`/${lang}`} class="flex items-center gap-3" aria-label={nav.home}>
      <img
        src={logoImg.src}
        alt=""
        width="36"
        height="36"
        class="h-8 w-auto sm:h-9"
      />
      <span class="hidden text-base font-medium tracking-tight sm:block">
        Ruang Cipta Digital
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={nav.products}>
      {
        links.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "hover:text-foreground hover:bg-accent rounded-full px-4 py-2 text-sm transition-colors",
                isActive ? "text-foreground" : "text-muted-foreground",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden items-center gap-1 md:flex">
      <ThemeToggle
        labelLight={nav.themeLight}
        labelDark={nav.themeDark}
        client:load
      />
      <LanguageSwitcher
        currentLang={lang}
        label={nav.language}
        client:load
      />
      <Button
        href={`mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL}`}
        variant="brand"
        class="ml-2 h-10 rounded-full px-5"
      >
        {nav.contact}
      </Button>
    </div>

    <!-- Mobile Navigation -->
    <div class="flex items-center gap-0.5 md:hidden">
      <ThemeToggle
        labelLight={nav.themeLight}
        labelDark={nav.themeDark}
        client:load
      />
      <MobileMenu lang={lang} navItems={nav} client:load />
    </div>
  </div>
</header>
