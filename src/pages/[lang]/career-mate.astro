---
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getContent } from "../../content";
import { LANGS, LANG } from "../../lib/i18n";
import ProductIntroduction from "../../lib/components/public/ProductIntroduction.astro";
import { getPublicProducts } from "../../lib/components/public/content";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

export const prerender = true;

const { lang } = Astro.params as { lang: LANG };
const content = getContent(lang);
const { seo } = content;
const products = getPublicProducts(content, lang);
const product = products.find((item) => item.slug === "career-mate")!;
const otherProduct = products.find((item) => item.slug !== product.slug);
---

<PublicLayout
  lang={lang}
  title={seo.careerMate.title}
  description={seo.careerMate.description}
  keywords={seo.careerMate.keywords}
  opengraph={{
    title: seo.careerMate.title,
    description: seo.careerMate.description,
    type: "website"
  }}
>
  <ProductIntroduction product={product} otherProduct={otherProduct} details={content.careerMate} lang={lang} />
</PublicLayout>
