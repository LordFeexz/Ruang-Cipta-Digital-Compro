---
import PublicLayout from "../../../layouts/PublicLayout.astro";
import { LANGS, LANG } from "../../../lib/i18n";
import { getContent } from "../../../content";
import TransactionFinishPage from "../../../lib/components/transaction/TransactionFinishPage.svelte";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

export const prerender = true;

const { lang } = Astro.params as { lang: LANG };
const content = getContent(lang);
---

<PublicLayout
  lang={lang}
  title={content.transactionFinish.pageTitle}
  robots={{ index: false, follow: false }}
>
  <TransactionFinishPage
    client:only="svelte"
    content={content.transactionFinish}
  >
    <div slot="fallback" class="mx-auto max-w-[780px] px-6 py-16">
      <p role="status" class="rounded-xl border border-border bg-card p-6 text-base text-muted-foreground">Memuat halaman transaksi…</p>
    </div>
  </TransactionFinishPage>
</PublicLayout>
